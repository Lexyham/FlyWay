# Required: replace with a unique, randomly generated secret before deploying.
JWT_SECRET=replace-with-a-long-random-secret

# Set to true and provide MONGODB_URI to use MongoDB instead of the persistent JSON volume.
USE_MONGODB=false
MONGODB_URI=
MONGODB_DB_NAME=flyway

# Local Ollama model used by the Docker Compose deployment.
OLLAMA_MODEL=llama3.2:3b

# Optional account, email and payment configuration.
ADMIN_PASSWORD=
BREVO_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FlyWay
BANK_NAME=
ACCOUNT_NAME=
ACCOUNT_NUMBER=
ROUTING_NUMBER=
SWIFT_CODE=
IBAN=
BTC_ADDRESS=
ETH_ADDRESS=
USDT_ADDRESS=
USDC_ADDRESS=
BNB_ADDRESS=
TWT_ADDRESS=
SOL_ADDRESS=
XRP_ADDRESS=
TRX_ADDRESS=
DOGE_ADDRESS=
PAYSTACK_NUM=
FLUTTER_NUM=
CASHAPP_TAG=
PAYPAL_EMAIL=
